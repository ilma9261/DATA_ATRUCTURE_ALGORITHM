// leetcode 1288

class Solution {
public:
    int removeCoveredIntervals(vector<vector<int>>& intervals) {
      sort(intervals.begin(),intervals.end(), [](vector<int> a,vector<int> b){
        if(a[0]==b[0]){
          return  a[1]>b[1];      // Put the interval that ends later first.
        }
        else{
          return a[0]<b[0];      // when starts are different, we need to compare the starting points:
        }
      });
      int cnt=1;                 // The first interval is always counted as remaining.
      int n=intervals.size();
      int maxEnd=intervals[0][1];
      for(int i=1;i<n;i++){
        if(intervals[i][1]>maxEnd){
            cnt++;
            maxEnd=intervals[i][1];
        }
      }
      return cnt;
    }
};
