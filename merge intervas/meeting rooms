class Solution {
  public:
    bool canAttend(vector<vector<int>> &arr) {
        sort(arr.begin(),arr.end());
        // Code Here
        int s1=arr[0][0];
        int e1=arr[0][1];
        for(int i=1;i<arr.size();i++){
            int s2=arr[i][0];
            int e2=arr[i][1];
            if(s2<e1){
                return false;
            }
            else{
                s1=s2;
                e1=e2;
            }
        }
        return true;
    }
};
