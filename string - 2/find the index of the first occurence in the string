// leetcode 28

// 1

class Solution {
public:
    int strStr(string haystack, string needle) {
            if(haystack.find(needle)!=string::npos){
                int idx=haystack.find(needle);                            // find() returns only the first occurrence of the substring.
                return idx;
            }
        return -1;
    }
};


// 2

class Solution {
public:
    int strStr(string haystack, string needle) {
        int idx=haystack.find(needle);
        if(idx!=string::npos){
            return idx;
        }
        return -1;
    }
};

// BRUTE FORCE

class Solution {
public:
    int strStr(string haystack, string needle) {
        int n = haystack.size();
        int m = needle.size();

        for (int i = 0; i <= n - m; i++) {
            int j;

            for (j = 0; j < m; j++) {
                if (haystack[i + j] != needle[j]) {
                    break;
                }
            }

            if (j == m) {
                return i;
            }
        }

        return -1;
    }
};
