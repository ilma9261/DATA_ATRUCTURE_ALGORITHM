// this is brute force approch we need sliding window for optimal

class Solution {
  public:
    int countSubstr(string& s, int k) {
        // code here
        int n=s.size();
        int ans=0;
        for(int i=0;i<n;i++){
            unordered_map<char, int> mp;
            for(int j=i;j<n;j++){            // j=i+1 for checking pairs , j=i for checking substrings
                mp[s[j]]++;
                if(mp.size()==k){
                    ans++;
                }
            }
        }
        return ans;
    }
};
