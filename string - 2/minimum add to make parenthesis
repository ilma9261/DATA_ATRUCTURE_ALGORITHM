// leetcode 921

class Solution {
public:
    int minAddToMakeValid(string s) {
        int start=0;
        int need=0;
        int n=s.size();
        for(int i=0;i<n;i++){
            if(s[i]=='('){
                start++;
            }
            if(s[i]==')'){
                if(start>0){
                    start--;
                }
                else{
                    need++;
                }
            }
        }
        return need+start;
    }
};
