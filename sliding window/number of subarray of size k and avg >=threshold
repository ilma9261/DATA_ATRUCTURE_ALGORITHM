// leetcode 1343

class Solution {
public:
    int numOfSubarrays(vector<int>& arr, int k, int threshold) {
        int n=arr.size();
        int sum=0;
        for(int i=0;i<k;i++){
            sum+=arr[i];
        }
        int avg=sum/k;
        int cnt=0;
        if(avg>=threshold){
            cnt++;
        }
        int i=0;
        int j=k;
        while(j<n){
            sum=sum-arr[i]+arr[j];
            avg=sum/k;
            if(avg>=threshold){
            cnt++;
          }
          i++;
          j++;
        }
        return cnt;
    }
};
