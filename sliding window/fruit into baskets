// leetcode 904

class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        int i=0;
        int j=0;
        int maxi=INT_MIN;
        int n=fruits.size();
        unordered_map<int,int> mp;
        while(j<n){
            mp[fruits[j]]++;
          while(mp.size()>2){
            mp[fruits[i]]--;
            if(mp[fruits[i]]==0){
                mp.erase(fruits[i]);
            }
            i++;
        }
            int len=j-i+1;
            maxi=max(maxi,len);
            j++;
        }
        return maxi;
    }
};
