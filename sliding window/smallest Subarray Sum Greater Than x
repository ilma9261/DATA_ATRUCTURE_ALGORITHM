class Solution {
  public:
    int smallestSubWithSum(int x, vector<int>& arr) {
        // code here
        int mini=INT_MAX;
        int i=0;
        int j=0;
        int sum=0;
        int n=arr.size();
        while(j<n){
            sum+=arr[j];
            while(sum>x){
                mini=min(mini,j-i+1);                // subarray length= j-i+1
                sum=sum-arr[i];
                i++;
            }
                j++;
        }
        if(mini==INT_MAX){
            return 0;
        }
        else{
            return mini;
        }
    }
};
