//max sum subarray of size k


class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        // code here
        int maxi=0;
        int sum=0;
        int n=arr.size();
        for(int j=0;j<k;j++){
            sum+=arr[j];
        }
        maxi=max(maxi,sum);
        int i=0;
        int j=k;
        while(j<n){                   // When j == n, arr[j] means arr[n], which is outside the array. because array is n-1 for 0 based indexing
            sum=sum-arr[i]+arr[j];
            i++;
            j++;
            maxi=max(sum,maxi);
            
        }
        return maxi;
    }
};


class Solution{
  public:
    long maxSubarraySum(vector<int>& Arr, int K){
        int n=Arr.size();
        int low=0;
        int high=K-1;
        int sum=0;
        for(int i=0;i<=high;i++){
             sum+=Arr[i];
        }
        int ans=sum;
        while(high<n-1){          // If you are doing high++ inside the loop, then the condition should usually be this otherwise it <= will go out of bound
            low++;
            high++;
            sum=sum-Arr[low-1]+Arr[high];
            ans=max(ans,sum);
        }
        return ans;
    }
};
