// leetcode 2461

class Solution {
public:
    long long maximumSubarraySum(vector<int>& nums, int k) {
        int n=nums.size();
        long long maxi=0;
        long long sum=0;
        unordered_map<int,int> mp;
        for(int i=0;i<k;i++){
                mp[nums[i]]++;
                sum+=nums[i];
        }
        if(mp.size()==k){
            maxi=sum;
        }
        int i=0;
        int j=k;
        while(j<n){
            sum=sum-nums[i]+nums[j];
            mp[nums[i]]--;
             if (mp[nums[i]] == 0) {
                mp.erase(nums[i]);
            }
            mp[nums[j]]++;
             if (mp.size() == k) {
                maxi = max(maxi, sum);
            }
            i++;
            j++;
        }
            return maxi;
    }
};
