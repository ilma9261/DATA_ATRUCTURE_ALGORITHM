// leetcode 3

class Solution {
public:
    int lengthOfLongestSubstring(string s) {
         int n=s.size();
        int maxi=0;
        int sum=0;
        unordered_map<int,int> mp;
        int i=0;
        int j=0;
        while(j<n){
            mp[s[j]]++;
            while(mp[s[j]]>1){
                mp[s[i]]--;
                i++;
            }
             maxi=max(maxi,j-i+1);
             j++;
        }
            return maxi;
    }
};
