#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int> v(n);
    for(int i=0;i<v.size();i++){
        cin>>v[i];
    }
    sort(v.begin(),v.end());
    int sum = 0;
    for(int i=v.size()-1;i>=v.size()-5;i--){
        sum+=v[i];
    }
    // int sum= accumulate(v.end()-5,v.end(),0);
    cout<<sum<<endl;
    for(int i=0;i<5;i++){
        cout<<v[i]<<" "<<endl;
    }
    return 0;
}
