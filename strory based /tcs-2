Problem Statement
Given an integer array Arr of size N, the task is to find the count of elements whose value is greater than all of its prior elements.

Note: The 1st element of the array should be considered in the count of the result.

Explanation
For example, Arr[] = {7, 4, 8, 2, 9}:

7 is the first element, so it will be considered in the result.

8 and 9 are also greater than all of their previous elements.

Since a total of 3 elements (7, 8, 9) meet the condition:

Hence the output = 3.



without function

#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int ans=1;
int maximum=arr[0];
for(int i=1;i<n;i++){
    if(arr[i]>maximum){
        ans++;
        maximum=arr[i];
    }
}
cout<<ans;
    return 0;
}



with function 

#include<iostream>
using namespace std;
int fun(int arr[],int n){
    int ans=1;
int maximum=arr[0];
for(int i=1;i<n;i++){
    if(arr[i]>maximum){
        ans++;
        maximum=arr[i];
    }
}
return ans;
}
int main(){
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    cout<<fun(arr,n);
    return 0;
}
