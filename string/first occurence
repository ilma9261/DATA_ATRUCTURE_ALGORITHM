class Solution {
  public:
    int firstOccurence(string& txt, string& pat) {
        // code here
        int j=0;
        for(int i=0;i<txt.size();i++){           // for(int i = 0; i <= n - m; i++)  more optimised
            for( j=0;j<pat.size();j++){
                if(txt[i+j]!=pat[j]){
                    break;                      // Whenever you use break inside a loop, the success check (j == pat.size()) is almost always done after the loop finishes not inside it.
                }
            }
            if(j==pat.size()){
                        return i;
                }
        }
        return -1;
    }
};

