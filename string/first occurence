class Solution {
  public:
    int firstOccurence(string& txt, string& pat) {
        // code here
        int j=0;
        for(int i=0;i<txt.size();i++){
            for( j=0;j<pat.size();j++){
                if(txt[i+j]!=pat[j]){
                    break;
                }
            }
            if(j==pat.size()){
                        return i;
                }
        }
        return -1;
    }
};
