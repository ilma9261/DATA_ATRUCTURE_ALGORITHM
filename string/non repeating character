class Solution {
  public:
    char nonRepeatingChar(string &s) {
        //  code here
        int n=s.size();
        unordered_map<char,int> mp;
        char res='$';
        for(int i=0;i<n;i++){
            mp[s[i]]++;
        }
        for(int i=0;i<n;i++){
            if(mp[s[i]]==1){
                res=s[i];
                return res;
            }
        }
        return res;
    }
};
