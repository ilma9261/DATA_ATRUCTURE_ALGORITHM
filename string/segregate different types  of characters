class Solution {
  public:
    vector<string> splitString(string s) {
        // code here
        int n=s.size();
        vector<string> v;
        string s1="";
        string s2="";
        string s3="";
        for(int i=0;i<n;i++){
            if((s[i]>='a' && s[i]<='z') || (s[i]>='A' && s[i]<='Z')){             // if the question is character alphabet related check both small an capital
                 s1+=s[i];
            }
            else if(s[i]>='0' && s[i]<='9'){
                 s2+=s[i];
            }
            else{
                 s3+=s[i];
            }
        }
       if(s1!="")                               // if(!s1.empty())
       {v.push_back(s1);}
       else{
           v.push_back("-1");
       }
       if(s2!=""){ v.push_back(s2);}
       else{v.push_back("-1");}
        if(s3!=""){v.push_back(s3);}
        else {v.push_back("-1");}
        return v;
    }
};
