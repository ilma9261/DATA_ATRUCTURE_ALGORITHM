class Solution {
  public:
    string convert(string& s) {
        // code here
        string ans="";                             // we cant directly do string ans=touppers[0] cause it gives character . we can add characters in a string but we have to initiate it as a string even if it is empty string .
        for(int i=0;i<s.size();i++){
            if(i==0 || s[i-1]==' '){
                ans+=toupper(s[i]);
            }
            else{
                 ans+=s[i];
            }
        }
        return ans;
    }
};
