// leetcode 1903

class Solution {
public:
    string largestOddNumber(string num) {
        string ans="";
        int n=num.size();
        int k;
        for(int i=n-1;i>=0;i--){
            if(num[i]%2!=0){
                k=i;
                break;                            // break is mandatory otherwise it will give runtime error
            }
        }
        for(int i=0;i<=k;i++){
            ans+=num[i];
        }
        return ans;
    }
};

// SLIGHTLY CLEANER VERSION

class Solution {
public:
    string largestOddNumber(string num) {
        int n = num.size();
        int k = -1;

        for (int i = n - 1; i >= 0; i--) {
            if ((num[i] - '0') % 2 != 0) {
                k = i;
                break;
            }
        }

        if (k == -1) {
            return "";
        }

        return num.substr(0, k + 1);                     // num.substr(start, length)
    }
};
