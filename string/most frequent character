class Solution {
  public:
    char getMaxOccuringChar(string& s) {
        //  code here
    unordered_map<char,int> mp;
    for(int i=0;i<s.size();i++){
        mp[s[i]]++;
    }
    char maxoccur=s[0];
    for(int i=0;i<s.size();i++){
       if(mp[s[i]]>mp[maxoccur]){
           maxoccur=s[i];
       }
       else if(mp[s[i]]==mp[maxoccur] && s[i]<maxoccur){
           maxoccur=s[i];
       }
    }
   return maxoccur; 
}
};
    
