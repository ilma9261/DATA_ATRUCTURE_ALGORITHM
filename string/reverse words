class Solution {
  public:
    string reverseWords(string &s) {
        // code here
        int n=s.size();
        string res="";
        string word="";
        vector<string> v;
        for(int i=0;i<n;i++){
            if(s[i]!='.'){
                word+=s[i];
            }
            else{
                if(word!=""){
                v.push_back(word);
                word="";
                }
            }
        }
        if(word!=""){
        v.push_back(word);
        }
        for(int i=v.size()-1;i>=0;i--){
            res+=v[i];
            if(i!=0){
            res+='.';
            }
        }
        return res;
    }
};
