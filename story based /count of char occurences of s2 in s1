#include <bits/stdc++.h>
using namespace std;

int main()
{
  string s1,s2;
  getline(cin,s1);
  getline(cin,s2);
  unordered_map<char,int> mp;
  for(int i=0;i<s1.size();i++){
      mp[s1[i]]++;
  }
  int sum=0;
  for(int i=0;i<s2.size();i++){
      if(mp.find(s2[i])!=mp.end()){
          sum+=mp[s2[i]];
      }
  }
  cout<<sum<<endl;
    return 0;
}
