Given:

First input = n (number of integers expected)

Second input = array elements

Steps:

If actual number of integers provided is less than n, print "Invalid Input".

Remove duplicates while keeping the first occurrence only.

Reverse the resulting array.

Print the reversed array.




#include <stdio.h>
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cin >> n;

    vector<int> v;
    int x;

    while(cin >> x){
        v.push_back(x);
    }

    if(v.size() < n){
        cout << "Invalid Input";
        return 0;
    }

    unordered_map<int,int> mp;
    vector<int> res;

    for(int i = 0; i < n; i++){
        if(mp[v[i]] == 0){
            res.push_back(v[i]);
            mp[v[i]]++;
        }
    }

 // reverse(res.begin(),res.end());
   
    int i = 0;
    int j = res.size() - 1;

    while(i < j){
        swap(res[i], res[j]);
        i++;
        j--;
    }

    for(auto it : res){
        cout << it << " ";
    }

    return 0;
}
