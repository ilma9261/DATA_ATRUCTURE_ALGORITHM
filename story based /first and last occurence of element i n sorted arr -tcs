Given a sorted array of integers of size n and a target value x, find the first occurrence of $x$ and the last occurrence of x,
then return the difference between the last and first occurrence. If the target element is not present in the array, print -1.




#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int> v(n);
    for(int i=0;i<n;i++){
        cin>>v[i];
    }
    int x;
    cin>>x;
    int low=0;
    int high=n-1;
    int first=-1;
    while(low<=high){
        int mid=(low+high)/2;
        if(v[mid]<x){
            low=mid+1;
        }
        else if(v[mid]>x){
            high=mid-1;
        }
        else{
            first=mid;
            high=mid-1;
        }
    }
     low=0;
     high=n-1;
    int last=-1;
    while(low<=high){
        int mid=(low+high)/2;
        if(v[mid]<x){
            low=mid+1;
        }
        else if(v[mid]>x){
            high=mid-1;
        }
        else{
           last=mid;
            low=mid+1;
        }
    }
    if(first==-1 && last==-1){
        cout<<-1<<endl;
    }
    else{
        cout<<last-first;
    }
    return 0;
}
