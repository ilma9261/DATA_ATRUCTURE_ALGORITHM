ou have given a string s and a character ch, your task is to find the first and last occurrence of the given character.  

NOTE: Return the first and last occurrence indexes  

Example 1:  
Input:  

s = "developer"

ch = 'e'

Output: {1,7}




#include <iostream>
#include <bits/stdc++.h>
using namespace std;

int main()
{
    string s;
    getline (cin,s);
   char ch;
   cin>>ch;
   int first=INT_MAX;
   int last=INT_MIN;
    for(int i=0;i<s.size();i++){
       if(s[i]==ch){
          first=min(first,i); 
          last=max(last,i);
       }
    }
    // Fix for character not found
    if (first == INT_MAX && last ==INT_MIN) {              // ALWAYS CHECK FOR HIDDEN TEST CASE(EDGE CASE) NO MATTER IF IT IS MENTIONED IN THE QUESTION OR NOT
        cout << "{-1,-1}" << endl;
    } else {
        cout << '{' << first << ',' << last << '}' << endl;
    }
    return 0;
}
