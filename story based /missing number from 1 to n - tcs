Problem Statement: You've got a list of numbers from 1 to N, but one is missing. Your mission?
Find that missing number! Write a smart plan (algorithm)

NOTE: Print the missing number.

Example 1:

Input:
N = 5
A[] = {1,2,3,5}
Output: 4

N = 10
A[] = {6,1,2,8,3,4,7,10,5}
Output: 9




#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
   int n;
   cin>>n;
   int arr[n-1];
   for(int i=0;i<n-1;i++){
       cin>>arr[i];                       // i can calculate sum here itself without using another loop
   }
   int totalSum=0;
   for(int i=1;i<=n;i++){
       totalSum+=i;
   }
   int arrSum=0;
   for(int i=0;i<n-1;i++){                   // arr.sizr() typo: arr is a raw array, not a std::vector or container. Raw arrays do not have a .size() member function
       arrSum+=arr[i];                       // vector<int> arr(n-1);   then i can use arr.size()
   }
   int miss=totalSum-arrSum;
   cout<<miss;
    return 0;
}



