Write a program to calculate the final payable amount after applying a discount based on total purchase amount.

Discount Rules:

Amount < ₹1,000: 5% Off

₹1,000 – ₹5,000: 10% Off

Amount > ₹5,000: 15% Off

Negative / < 0 input: Error

Example:

Input: 1200

Output: Pay ₹1,080 (or 1080)




// TWO WAYS

#include <iostream>
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cin >> n;

    if(n < 0){
        cout << "Error";
        return 0;
    }

    if(n < 1000){
        int p = n * 5 / 100;                       // dont use bracket here otherwise it will become zero
        cout << n - p;
        return 0;
    }

    if(n >= 1000 && n <= 5000){
        int p = n * 10 / 100;               
        cout << n - p;
        return 0;
    }

    if(n > 5000){
        int p = n * 15 / 100;
        cout << n - p;
        return 0;
    }

    return 0;
}



