Write a function to find the longest common prefix string amongst an array of strings. If there is no common prefix, return an empty string "".

Example 1:
Input: strs = ["flower","flow","flight"]

Output: "fl"

Example 2:
Input: strs = ["dog","racecar","car"]




// A prefix always means the beginning of a string

#include<iostream>
#include<bits/stdc++.h>
using namespace std;
int main(){
    string s;
    getline(cin,s);
    stringstream ss(s);
    vector<string> arr;
    string temp;
    while(getline(ss,temp,',')){
        arr.push_back(temp);
    }
        sort(arr.begin(),arr.end());
        int n=arr.size();
string start=arr[0];
string last=arr[n-1];
string ans="";
for(int i=0;i<start.size();i++){
    if(start[i]!=last[i]){
        break;
    }
    ans+=start[i];
}
cout<<ans;
    return 0;
}
