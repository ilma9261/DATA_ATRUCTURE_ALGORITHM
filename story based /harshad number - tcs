You are playing a game in which you have to find the good number or bad number. A number is a good number if the number is divisible by the sum of its digits.  

NOTE: Print 'Good Number' if number is a good number else print 'Bad Number'

Sample Test 1:
Input: num = 3

Output: Good Number

Sample Test 2:
Input: num = 27

Output: Good Number




#include <iostream>
#include <bits/stdc++.h> 
using namespace std;

int main()
{
    int n;
    cin>>n;
    int sum=0;
    int num=n;
    // Handle edge case where n is 0
    if (n == 0) {
        cout << "Bad Number" << endl;
        return 0;
    }
    while(n!=0){
        int digit=n%10;
        sum+=digit;
        n=n/10;
    }
    if(num%sum==0){
        cout<<"Good Number";
    }
    else{
        cout<<"Bad Number";
    }
    return 0;
}
