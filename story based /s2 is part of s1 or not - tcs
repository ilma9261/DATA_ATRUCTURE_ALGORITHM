You have given two stirng s1 and s2, your mission is to check second string s2 is the part of first string s1 or not.

NOTE: If s2 part of the s1 then return true otherwise return false

Example 1:

Input:
Input:
s1 = "developer" sum = 1 + 3 + 1 = 5
s2 = "lope"
Output: true

Example 2:
Input:
s1 = "developer"
s2 = "del"
Output: false





// subsequence and substring is different
// for subsequence , we can use two pointer approach but for substring we need different approach

#include <iostream>
#include <bits/stdc++.h>
using namespace std;

int main()
{
   string s1,s2;
   getline(cin,s1);
   getline(cin,s2);
  int n = s1.size();
    int m = s2.size();

    if (m > n) {
        cout << "false" << endl;
        return 0;
    }
 
    int j;                                              // we need to declare j outside loop
  
    for (int i = 0; i <= n - m; i++) {                   // Bound updated to 'i <= n - m' to prevent reading out of bounds
        for (j = 0; j < m; j++) {
            if (s1[i + j] != s2[j]) {
                break;                                   // Mismatch found, stop inner loop
            }
        }
        if (j == m) {
            cout << "true" << endl;
            return 0;
        }
    }

    cout << "false" << endl;
    return 0;
}
