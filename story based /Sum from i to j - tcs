You are given two integers

i and j.

Your task is to calculate and print the sum of all integers from i to j, inclusive.




#include <iostream>
using namespace std;
int main()
{
    int i,j;
    cin>>i>>j;
    int sum=0;
    for(int k=i;k<=j;k++){
        sum+=k;
    }
    cout<<sum;
    return 0;
}
