Given a single string, Do +2,-1 Encoding.Rules:Characters at even index $(0, 2, 4, \dots) \rightarrow$ move forward by 2 positions.
Characters at odd index $(1, 3, 5, \dots) \rightarrow$ move backward by 1 position.Special cases:$\text{Z} \rightarrow \text{B}$$\text{z} 
\rightarrow \text{b}$$\text{A} \rightarrow \text{Z}$$\text{a} \rightarrow \text{z}$$0 \rightarrow 9$If the string contains a space, 
print:$$\text{Error}$$and stop execution.




#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
   string s;
   getline(cin,s);   
   string ans="";
   for(int i=0;i<s.size();i++){
        if(s[i]==' '){
    cout<<"Error";
    return 0;
    }
      if(i%2==0){
          if(s[i]=='Z'){
              ans+='B';
          }
          else if(s[i]=='z'){
              ans+='b';
          }
          else{
              ans+=s[i]+2;
          }
      }
      else{
          if(s[i]=='A'){
              ans+='Z';
          }
          else if(s[i]=='a'){
              ans+='z';
          }
          else if(s[i]=='0'){
              ans+='9';
          }
          else{
              ans+=s[i]-1;
          }
      }
   }
   cout<<ans;
    return 0;
}
