You are given an array of integers and a target value. Find the index of the first occurrence of the target value in the array.

If the target is not present in the array, return -1.

Example

Input:

arr = [4, 2, 7, 2, 9, 2]

target = 2

Output:

1






#include <iostream>
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int k;
    cin>>k;
    for(int i=0;i<n;i++){
        if(arr[i]==k){
            cout<<i;
            return 0;
        }
    }
    cout<<-1;
    return 0;
}
