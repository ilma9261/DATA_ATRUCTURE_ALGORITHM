Understanding the Problem Statement

Inputs:

N: Length of the NUM array.

X: Lower bound of the valid range.

Y: Upper bound of the valid range.

NUM: Array of numbers.

Operations:

Form pairs (NUM[i], NUM[j]).

Concatenate them (like 5 and 5 becomes 55).

Check if X <= Concatenated Number <= Y.

Count how many such valid pairs exist.





#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main(){
   int t;
   cin>>t;
   while(t--){
        int n,x,y;
    cin>>n>>x>>y;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
     int cnt=0;
     for(int i=0;i<n;i++){
         for(int j=0;j<n;j++){
             if(i==j){
                 continue;       // continue - "Skip only this iteration and go to the next value of j."
             }                   // // break - "Stop the entire inner loop and go to the next value of i." 
             
             string s=to_string(arr[i])+to_string(arr[j]);
             int concat=stoi(s);
             if(concat>=x && concat<=y){
                 cnt++;
             }
             
            }
        }
        cout<<cnt<<endl;
    
   }
    return 0;
}





