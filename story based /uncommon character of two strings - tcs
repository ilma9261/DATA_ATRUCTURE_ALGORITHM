Given two strings S1 and S2 of lowercase alphabets, find the list of uncommon characters for the two strings.  

A character is uncommon if it is present only in one of the strings. It is either present in S1 or S2, but not in both.  

Note :  

Both the strings contain only lowercase alphabets and can contain duplicates.  

Return the uncommon characters in sorted order and can not contain duplicates.

Example 1:

Plaintext
s1 = digital, s2 = ninja
Output: dgjlnt



// OPTIMISED


#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
    string s1,s2;
    getline(cin,s1);
    getline(cin,s2);
    map<char,int> mp1;
    for(int i=0;i<s1.size();i++){
        mp1[s1[i]]++;
    }
    map<char,int> mp2;
    for(int i=0;i<s2.size();i++){
        mp2[s2[i]]++;
    }
    
    set<char> st;                          // set store elements with sorting and discards duplicate elements
    for(int i=0;i<s1.size();i++){
        if(mp2.find(s1[i])==mp2.end()){
            st.insert(s1[i]);
            
        }
    }
    for(int i=0;i<s2.size();i++){
        if(mp1.find(s2[i])==mp1.end()){
           st.insert(s2[i]);
            
        }
    }
   for(auto it:st){
       cout<<it;
   }
    return 0;
}





// BRUTE FORCE


#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
    string s1,s2;
    getline(cin,s1);
    getline(cin,s2);
    map<char,int> mp1;
    for(int i=0;i<s1.size();i++){
        mp1[s1[i]]++;
    }
    map<char,int> mp2;
    for(int i=0;i<s2.size();i++){
        mp2[s2[i]]++;
    }
    string ans="";

    for(int i=0;i<s1.size();i++){
        if(mp2.find(s1[i])==mp2.end()){
            ans+=s1[i];
            mp2[s1[i]]++;
        }
    }
    for(int i=0;i<s2.size();i++){
        if(mp1.find(s2[i])==mp1.end()){
            ans+=s2[i];
            mp1[s2[i]]++;
        }
    }
    sort(ans.begin(),ans.end());
    cout<<ans<<endl;
    return 0;
}
