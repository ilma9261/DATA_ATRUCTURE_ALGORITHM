You are given two arrays:

Array A is sorted in ascending order.

Array B is sorted in descending order.

Create a new array containing all elements from both arrays such that the final array is sorted in ascending order.

Example:

Input:

A = [1, 3, 5, 7]

B = [10, 8, 6, 4]

Output:

[1, 3, 4, 5, 6, 7, 8, 10]





#include <iostream>
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n1, n2;
    cin >> n1 >> n2;

    int arr1[n1];
    int arr2[n2];

    for(int i = 0; i < n1; i++){
        cin >> arr1[i];
    }

    for(int i = 0; i < n2; i++){
        cin >> arr2[i];
    }

    int i = 0;
    int j = n2 - 1;

    vector<int> v;

    while(i < n1 && j >= 0){
        if(arr1[i] < arr2[j]){
            v.push_back(arr1[i]);
            i++;
        }
        else{
            v.push_back(arr2[j]);
            j--;
        }
    }

    while(i < n1){
        v.push_back(arr1[i]);
        i++;
    }

    while(j >= 0){
        v.push_back(arr2[j]);
        j--;
    }

    for(auto it : v){
        cout << it << " ";
    }

    return 0;
}
