Airport security officials have confiscated several item of the passengers at the security check point. All the items have been dumped into a huge box (array). Each item possesses a 
certain amount of risk[0,1,2]. Here, the risk severity of the items represent an array[] of N number of integer values. The task here is to sort the items based on their levels of risk
in the array. The risk values range from 0 to 2.




#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int low=0;
    int mid=0;
    int high=n-1;
while(mid<=high){
    if(arr[mid]==0){
        swap(arr[mid],arr[low]);
            low++;
            mid++;
         }
        else if(arr[mid]==1){
            mid++;
        }
        else{
            swap(arr[mid],arr[high]);
            high--;
        }
}
for(int a:arr){             
    cout<<a;
}
    return 0;
}
