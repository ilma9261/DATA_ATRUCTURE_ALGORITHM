2- 

  #include <iostream>
#include <vector>
#include <map>
#include <algorithm>
using namespace std;

int main()
{
    int n, m;
    cin >> n >> m;
    int arr1[n], arr2[m];

    for(int i = 0; i < n; i++){
        cin >> arr1[i];
    }
    for(int i = 0; i < m; i++){
        cin >> arr2[i]; 
    }
    map<int, int> mp;

    // Step 1: Insert all elements of arr1 into the map
    for(int i = 0; i < n; i++){
        mp[arr1[i]]++;
    }
    // Step 2: Insert all elements of arr2 into the map
    for(int i = 0; i < m; i++){
        mp[arr2[i]]++;
    }

    vector<int> v;
    
    // Step 3: Extract unique values from arr1
    for(int i = 0; i < n; i++){
        if(mp.find(arr1[i]) != mp.end()){
            v.push_back(arr1[i]);
            mp.erase(arr1[i]);
        }
    }
    // Step 4: Extract remaining unique values from arr2
    for(int i = 0; i < m; i++){
        if(mp.find(arr2[i]) != mp.end()){
            v.push_back(arr2[i]);
            mp.erase(arr2[i]);
        }
    }

    // Step 5: Sort the vector in ascending order
    sort(v.begin(), v.end());

    // Step 6: Print elements separated by spaces
    for(int i = 0; i < v.size(); i++){
        cout << v[i] << ' ';
    }
    cout << endl;

    return 0;
}
