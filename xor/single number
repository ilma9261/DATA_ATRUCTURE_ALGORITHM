// leetcode 136


// "XOR has the property that x ^ x = 0 and x ^ 0 = x, so two identical elements cancel each other."

class Solution {
public:
    int singleNumber(vector<int>& nums) {
        int n=nums.size();
        int ans=0;
        for(int i=0;i<n;i++){
            ans^=nums[i];
        }
        return ans;
    }
};
