#include <iostream>
using namespace std;
void nameNtimes(int n){          // We made the function void because the function's job is only to print "gfg" n times, not to return a value.
    if(n==0){
        return ;
    }
    else{
        cout<<"GFG"<<' ';      
        nameNtimes(n-1);
    }
}
int main() {
    int n;
    cin >> n;

    // code here
    nameNtimes(n);

    return 0;
}


