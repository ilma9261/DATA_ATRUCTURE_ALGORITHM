// WITH RECURSION

#include <iostream>
using namespace std;
int recurSum(int n){

    // base case
    if (n == 0)
        return 0;

    // recursive case
    return n + recurSum(n - 1);
}

int main() {
    int n;
    cin >> n;

    // code here
    cout<<recurSum(n);

    return 0;
}
