class Solution {
  public:
    vector<int> primeFactors(int n) {
        // code here
        vector<int> v;
        for(int i=2;i*i<=n;i++){
            while(n%i==0){
                v.push_back(i);
                n=n/i;
            }
        }
        if(n>1){
            v.push_back(n);
        }
        return v;
    }
};
