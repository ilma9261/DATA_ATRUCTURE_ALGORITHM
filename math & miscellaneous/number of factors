// two approaches

// 1

class Solution {
  public:
    int countFactors(int n) {
        // code here
        int factor=0;
        for(int i=1;i<=n;i++){
            if(n%i==0){
                factor++;
            }
        }
        return factor;
    }
};

// 2

class Solution {
  public:
    int countFactors(int n) {
        // code here
        int factor=2;                      // cause even for prime numbers there will be always two factors
        for(int i=2;i<=n/2;i++){
            if(n%i==0){
                factor++;
            }
        }
        return factor;
    }
};
