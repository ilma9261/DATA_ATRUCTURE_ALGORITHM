class Solution {
  public:
    string convert(string& s) {
        // code here
        string ans="";
        for(int i=0;i<s.size();i++){
            if(i==0 || s[i-1]==' '){
                ans+=toupper(s[i]);
            }
            else{
                 ans+=s[i];
            }
        }
        return ans;
    }
};
