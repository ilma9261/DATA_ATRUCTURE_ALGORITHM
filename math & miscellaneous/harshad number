// leetcode 3099

class Solution {
public:
    int sumOfTheDigitsOfHarshadNumber(int x) {
        int num=x;
        int digitSum=0;
        while(x!=0){
            int digit=x%10;
            digitSum+=digit;
            x=x/10;
        }
        if(num%digitSum==0){
            return digitSum;
        }
        return -1;
    }
};
