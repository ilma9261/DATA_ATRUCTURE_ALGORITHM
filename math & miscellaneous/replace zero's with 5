class Solution {
  public:
    int convertFive(int n) {
        // code here
        string str=to_string(n);
        string ans="";
        for(int i=0;i<str.size();i++){
            if(str[i]!='0'){
                ans+=str[i];
            }
            else{
                ans+='5';
            }
        }
        return stoi(ans);         // to integer
    }
};
