class Solution {
  public:
    bool isPerfect(int n) {
        // code here
        int sum=0;
        int num=n;
        if(n==1){
            return false;
        }
        for(int i=1;i*i<=n;i++){
            if(n%i==0){
                sum+=i;
                if(n/i!=i && n/i!=n){
                    sum+=n/i;
                }
            }
        }
        if(num==sum){
            return true;
        }
        return false;
    }
};



