class Solution {
  public:
  public:
  int fact(int n){
      if(n==0){
          return 1;
      }
      return  n*fact(n-1);
  }
    bool isStrong(int n) {
        // code here
        int ans=0;
        int num=n;
       while(n!=0){
           int digit=n%10;
           ans+=fact(digit);
           n=n/10;
       }
       if(ans==num){
           return true;
       }
       return false;
    }
};
