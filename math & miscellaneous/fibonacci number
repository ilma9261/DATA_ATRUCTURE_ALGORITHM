// two methods


// without recursion
// leetcode 509

class Solution {
public:
    int fib(int n) {
        int firstNumber=0;
        int secondNumber=1;
        if(n==0){
            return 0;
        }
       else if(n==1){
            return 1;
        }
        for(int i=2;i<=n;i++){
            int thirdNumber=firstNumber+secondNumber;
            firstNumber=secondNumber;
            secondNumber=thirdNumber;
        }
        return secondNumber;
    }
};


// with recursion
// gfg

class Solution {
  public:
    // Function to return list containing first n fibonacci numbers.
    int fib(int n){
        if(n==0){
            return 0;
        }
        if(n==1){
            return 1;
        }
        return fib(n-1)+fib(n-2);
    }
    vector<int> fibonacciNumbers(int n) {
        // code here
        vector<int> v;
        for(int i=0;i<n;i++){
            v.push_back(fib(i));
        }
        return v;
    }
};
