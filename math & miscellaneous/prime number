class Solution {
  public:
    bool isPrime(int n) {
        // code here
        if(n==1){                         // 1 is not a primenumber 
            return false;
        }
        for(int i=2;i<=n/2;i++){
            if(n%i==0){                      //  example - Since 2 < 1 is false, the loop never executes so it is a prime number
                return false;
            }
            }
        return true;
    }
};
