// leetcode 34

class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int n=nums.size();
        int low=0;
        int high=n-1;
        vector<int> v;
        int first=-1;
        int last=-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(nums[mid]<target){
                low=mid+1;
            }
            if(nums[mid]>target){
                high =mid-1;
            }
            if(nums[mid]==target){
                first=mid;
                high=mid-1;
            }
        }
        v.push_back(first);

        // low and high are changing after first loop so we need to reset it
        
        low=0;
        high=n-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(nums[mid]<target){
                low=mid+1;
            }
            if(nums[mid]>target){
                high =mid-1;
            }
            if(nums[mid]==target){
                last=mid;
                low=mid+1;
            }
        }
        v.push_back(last);
        return v;
    }
};
