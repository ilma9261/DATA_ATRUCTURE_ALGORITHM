Given a string containing only lowercase English letters, find an equilibrium index.Assign values to the letters as follows:$a = 1, b = 2, 
\dots, z = 26$An index $i$ is an equilibrium index if:$$\text{sum of values of all characters before } i = \text{sum of values of all
characters after } i$$The character at index $i$ itself is not included in either sum.If multiple equilibrium indices exist, return the
first one. If no equilibrium index exists, return -1.



// using prefix sum logic

#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
   string s;
   cin>>s;     
   int sum=0;
   for(int i=0;i<s.size();i++){
       int current=s[i]-'a'+1;
       sum+=current;
   }
   int left=0;
   for(int i=0;i<s.size();i++){
       int current=s[i]-'a'+1;
       int right=sum-left-current;
       if(left==right){
           cout<<i<<endl;
           return 0;
       }
       left+=current;
   }
   cout<<-1<<endl;
    return 0;
}
