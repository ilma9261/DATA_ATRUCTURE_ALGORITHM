There are N stacks of coins on a table. Each stack contains a certain number of coins.

You start with a score of 0. In each round:

Add the total number of coins currently present in all stacks to your score.

Choose and remove one stack from the table.

The game ends when all the stacks have been removed.

You are given:

An integer N, representing the number of stacks.

A string S of length N, containing digits from 0 to 9. The i-th digit represents the number of coins in the i-th stack.

Find the minimum possible total score after all stacks have been removed.





#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
   string s;
   cin>>s;    
   sort(s.begin(),s.end());
   int sum=0;
   for(int i=0;i<n;i++){
       int current=s[i]-'0';
      sum+=current;
   }
   int score=0;
   for(int i=n-1;i>=0;i--){
       score+=sum;
       int current=s[i]-'0';
       sum-=current;
   }
   cout<<score<<endl;
    return 0;
}
