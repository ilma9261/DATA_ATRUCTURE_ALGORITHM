Write a function to accept a string and move all # characters to the front while keeping the other characters in their relative positions.
Constraints: $1 \le \text{length of string} \le 100$The string will contain only alphabets and #.Input: A string str of length n.
Output: A modified string with all # at the front.Example:Input: Move#Hash#to#FrontOutput: ###MoveHashtoFront




#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
   string s;
   getline(cin,s);   
   string ans="";
   for(int i=0;i<s.size();i++){
       if(s[i]=='#'){
           ans+=s[i];
       }
   }
   for(int i=0;i<s.size();i++){
       if(s[i]!='#'){
           ans+=s[i];
       }
   }
   cout<<ans<<endl;
    return 0;
}
