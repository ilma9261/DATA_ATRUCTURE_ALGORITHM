You are given a string $S$ containing digits from 0 to 9, where each digit represents the price of a stock on a particular day.You can:Buy 
the stock once on any day.Sell the stock once on a later day.You must buy before you sell.Find the maximum possible profit.If no profit can
be made, return 0.Input FormatThe first line contains an integer $N$, representing the number of days.The second line contains a string $S$
of length $N$, where each character represents the stock price on that day.Output FormatPrint a single integer representing the maximum 
profit possible.




#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
   int n;
   cin>>n;
   string s;
   cin>>s;
   int mini=s[0]-'0';              //It is an input-handling detail, not part of the algorithm. ex- '7' - '0' = 7
   int ans=0;
   for(int i=0;i<n;i++){
       int price=s[i]-'0';
       mini=min(mini,price);
       int profit=price-mini;
       ans=max(ans,profit);
   }
   cout<<ans<<endl;
    return 0;
}
