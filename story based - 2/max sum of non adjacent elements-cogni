Problem StatementYou are given an array of $N$ integers. Your task is to find the maximum possible sum by selecting elements from the array
such that no two selected elements are adjacent.You can select any number of elements, but if an element at index $i$ is selected, the
elements at indices $i - 1$ and $i + 1$ cannot be selected.Input FormatThe first line contains an integer $N$, representing the number of 
elements in the array.The second line contains $N$ space-separated integers representing the array elements.Output FormatPrint a single 
integer representing the maximum sum of non-adjacent elements.Constraints$1 \le N \le 100000$$0 \le A[i] \le 100000$



// DP

#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
   int n;
   cin>>n;
   vector<int> v(n);
   for(int i=0;i<n;i++){
       cin>>v[i];
   }
   int prev2=0;
   int prev1=v[0];
   for(int i=1;i<n;i++){
       int take=v[i]+prev2;
       int skip=prev1;
       int current =max(take,skip);
       prev2=prev1;
       prev1=current;
   }
   cout<<prev1;
    return 0;
}
