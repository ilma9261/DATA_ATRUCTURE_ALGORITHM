// leetcode 14

class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        sort(strs.begin(),strs.end());
        int n=strs.size();
        string start=strs[0];
        string last=strs[n-1];
        string ans="";
        for(int i=0;i<start.size();i++){
            if(start[i]==last[i]){                                // start[i]!=last[i]
                ans+=start[i];                                       break;
            }
            else{
                break;                                           // ans+=start[i]
            }
        }
        return ans;
    }
};
