class Solution {
  public:
    string equilibrium(vector<int> &arr) {
        // code here
        int n=arr.size();
        int sum=0;
        for(int i=0;i<n;i++){
            sum+=arr[i];
        }
        int left=0;
        for(int i=0;i<n;i++){
            int right=sum-arr[i]-left;
            if(right==left){
                return "true";
            }
            left+=arr[i];
        }
        return "false";
    }
};
