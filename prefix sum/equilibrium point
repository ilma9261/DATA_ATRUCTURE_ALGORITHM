class Solution {
  public:
    int findEquilibrium(vector<int> &arr) {
        // code here
        int n=arr.size();
        int sum=0;
        for(int i=0;i<n;i++){
            sum+=arr[i];
        }
        int left=0;
        for(int i=0;i<n;i++){
            int right=sum-left-arr[i];
            if(left==right){
                return i;
            }
            left+=arr[i];
        }
        return -1;
    }
};
