// bruteforce

class Solution {
  public:
    vector<vector<int>> countFreq(vector<int>& arr) {
        // code here
        int n=arr.size();
        sort(arr.begin(),arr.end());
        vector<vector<int>> v;
        unordered_map<int,int> mp;
        for (int i=0;i<n;i++){
            mp[arr[i]]++;
        }
        v.push_back({arr[0],mp[arr[0]]});
        for(int i=1;i<n;i++){
            if(arr[i]>arr[i-1]){
            v.push_back({arr[i],mp[arr[i]]});
            }
        }
        return v;
    }
};

// optimised solution

class Solution {
  public:
    vector<vector<int>> countFreq(vector<int>& arr) {
        // code here
        int n=arr.size();
        vector<vector<int>> v;
        unordered_map<int,int> mp;
        for (int i=0;i<n;i++){
            mp[arr[i]]++;
        }
       
        for(int i=0;i<n;i++){
           if (mp.find(arr[i]) != mp.end()) {             // element present
                v.push_back({arr[i], mp[arr[i]]});
                mp.erase(arr[i]);                         // remove it after adding
            }
        }
        return v;
    }
};
