class Solution {
  public:
    int countFreq(vector<int>& arr, int target) {
        // code here
        int n=arr.size();
        unordered_map<int,int> mp;
        int res=0;
        for(int i=0;i<n;i++){
            mp[arr[i]]++;
        }
        for(int i=0;i<n;i++){
            if(arr[i]==target){
                res=mp[arr[i]];
            }
        }
        return res;
    }
};
