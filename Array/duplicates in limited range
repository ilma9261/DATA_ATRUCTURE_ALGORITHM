class Solution {
  public:
    vector<int> findDuplicates(vector<int>& arr) {
        // code here
        int n=arr.size();
        vector<int> v;
        unordered_map<int,int> mp;
        for(int i=0;i<n;i++){
           mp[arr[i]]++;
        }
        for(int i=0;i<n;i++){
            if(mp[arr[i]]==2){
                v.push_back(arr[i]);
                mp.erase(arr[i]);
            }
        }
        return v;
    }
};
