// leetcode 229   and   // leetcode 169

class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        int n=nums.size();
        int k=n/3;
        unordered_map<int,int> mp;
        for(int i=0;i<n;i++){
            mp[nums[i]]++;
        }
        vector<int> v;
        for(int i=0;i<n;i++){
            if(mp[nums[i]]>k){
                v.push_back(nums[i]);
                mp.erase(nums[i]);
            }
        }
        return v;
    }
};


class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n=nums.size();
        int k=n/2;
        unordered_map<int,int> mp;
        for(int i=0;i<n;i++){
            mp[nums[i]]++;
        }
        for(int i=0;i<n;i++){
            if(mp[nums[i]]>k){
                return nums[i];
            }
        }
      return -1;
    }
};
