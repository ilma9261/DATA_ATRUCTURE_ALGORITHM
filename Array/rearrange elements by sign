// leetcode 2149

class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n=nums.size();
        vector<int> v(n);
        int posIndx=0;
        int negIndx=1;
        for(int i=0;i<n;i++){
            if(nums[i]>0){
                v[posIndx] = nums[i];
                posIndx+=2;
            }
            else{
                v[negIndx]=nums[i];
                negIndx+=2;
            }
        }
        return v;
    }
};
