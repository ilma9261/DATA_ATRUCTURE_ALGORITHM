// leetcode 128


class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        int n=nums.size();
        unordered_set<int> st;
        for(int i=0;i<n;i++){
            st.insert(nums[i]);
        }
        int ans=0;
        for(auto x:st){
            if(st.find(x-1)==st.end()){
                int cnt=1;
                int current=x;
                while(st.find(current+1)!=st.end()){
                    cnt++;
                    current++;
                }
                 ans=max(cnt,ans);
            }
        }
        return ans;
    }
};
