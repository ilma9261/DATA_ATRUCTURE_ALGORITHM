If you write:

arr[i]

➡️ i = array index

If you write:

mp[i]

➡️ i = map key (number)

class Solution {
public:
    vector<int> frequencyCount(vector<int>& arr) {

        int n = arr.size();
        unordered_map<int, int> mp;

        for (int i = 0; i < n; i++) {
            mp[arr[i]]++;
        }

        vector<int> v;

        for (int i = 1; i <= n; i++) {
            v.push_back(mp[i]);
        }

        return v;
    }
};
