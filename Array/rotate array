class Solution {
  public:
    void rotateArr(vector<int>& arr, int d) {
        int n=arr.size();
        d=d%n;                    // If d is bigger than the array size, make it smaller because rotating more than n times repeats the same pattern.   d = 2 % 5 = 2   ,    d = 7 % 5 = 2
        int i=0;
        int j=d-1;
        while(i<j){
            swap(arr[i],arr[j]);
            i++;
            j--;
        }
        i=d;
        j=n-1;
        while(i<j){
            swap(arr[i],arr[j]);
            i++;
            j--;
        }
        i=0;
        j=n-1;
        while(i<j){
            swap(arr[i],arr[j]);
            i++;
            j--;
        }
    }
};
