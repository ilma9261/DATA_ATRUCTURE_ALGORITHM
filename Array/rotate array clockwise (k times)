class Solution {
  public:
    void rotateclockwise(vector<int>& arr, int k) {
        // code here
        int n=arr.size();
         k= k%n;
        int i=0;
        int j=n-1-k;                   ;
        while(i<j){
            swap(arr[i],arr[j]);
            i++;
            j--;
        }
        i=n-k;
        j=n-1;
        while(i<j){
            swap(arr[i],arr[j]);
            i++;
            j--;
        }
        i=0;
        j=n-1;
         while(i<j){
            swap(arr[i],arr[j]);
            i++;
            j--;
        }
    }
};
